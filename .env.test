# =============================================================================
# LexPortal – Zmienne środowiskowe
# =============================================================================
# INSTRUKCJA TESTÓW Z NGROK:
#   1. Uruchom ngrok: ngrok http 80
#   2. Skopiuj adres Forwarding (https://...) i wklej w APP_BASE_URL poniżej
#   3. Przeładuj backend: docker-compose up -d backend
# =============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lexportal
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Połączenie do DB (wewnątrz Dockera)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lexportal

# Redis
REDIS_URL=redis://redis:6379/0

# Bezpieczeństwo
SECRET_KEY=supersecretkey

# ---------------------------------------------------------------------------
# Mollie – Integracja płatności
# ---------------------------------------------------------------------------

# Klucz API Mollie (test_ lub live_)
# Skopiuj z: https://my.mollie.com/dashboard/developers/api-keys
MOLLIE_API_KEY=test_by5RsHsNM7yBm6GzU4Mn4FvJpSzDbd

# Publiczny URL aplikacji – używany do:
#   - redirectUrl po płatności:  APP_BASE_URL/#/payment/status?case_id=UUID
#   - webhookUrl dla Mollie:     APP_BASE_URL/api/v1/payments/webhook
#
# DEV z ngrok → wklej URL z terminala ngrok (np. https://abc-123.ngrok-free.app)
# PROD        → https://twoja-domena.pl
# Lokalnie    → http://localhost  (płatności testowe bez prawdziwego webhook)
#
# ⚠️  NIE kończ ukośnikiem (/)
APP_BASE_URL=https://sniffily-pseudoascetical-dania.ngrok-free.dev

# Mollie Profile ID (opcjonalnie – do Dashboard)
PROFILE_ID=pfl_UbTA7mArD3

# Gemini API KEY
